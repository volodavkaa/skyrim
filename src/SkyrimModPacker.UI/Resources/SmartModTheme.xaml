<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#101722"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F6FC"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B4C3D5"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#34465E"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFB4B4"/>
    <SolidColorBrush x:Key="SmartSurface" Color="#182332"/>
    <SolidColorBrush x:Key="SmartCard" Color="#1C2A3C"/>
    <SolidColorBrush x:Key="SmartInput" Color="#111D2D"/>
    <SolidColorBrush x:Key="SmartAccent" Color="#80D8CF"/>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#26384F"/><Setter Property="Foreground" Value="#F2F6FC"/>
        <Setter Property="BorderBrush" Value="#405873"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,3,6,3"/>
        <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80D8CF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B0F0E8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#92A2B7"/><Setter TargetName="Surface" Property="Background" Value="#1C2838"/><Setter TargetName="Surface" Property="BorderBrush" Value="#2B3B4E"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SmartPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#80D8CF"/><Setter Property="Foreground" Value="#102C2C"/><Setter Property="BorderBrush" Value="#80D8CF"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SmartDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#38262E"/><Setter Property="Foreground" Value="#FFC3C3"/><Setter Property="BorderBrush" Value="#76505C"/>
    </Style>
    <Style x:Key="SmartNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SmartInput}"/><Setter Property="Foreground" Value="#F2F6FC"/>
        <Setter Property="BorderBrush" Value="#405873"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="#F2F6FC"/><Setter Property="SelectionBrush" Value="#3F697B"/>
        <Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80D8CF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#92A2B7"/></Trigger>
                <Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFB4B4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SmartComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="Background" Value="#18283B"/>
        <Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#304A64"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#285454"/><Setter Property="Foreground" Value="#E2FFFA"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#92A2B7"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{StaticResource SmartInput}"/><Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="BorderBrush" Value="#405873"/>
        <Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="MinHeight" Value="38"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="MaxDropDownHeight" Value="300"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SmartComboItem}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid ClipToBounds="True">
                <ToggleButton x:Name="DropToggle" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="#111D2D" BorderBrush="#405873" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#B4C3D5" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,4"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80D8CF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80D8CF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Margin="10,9,32,9" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" TextElement.Foreground="#F2F6FC" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="#18283B" BorderBrush="#648393" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#24374C"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#24424D"/><Setter TargetName="Surface" Property="BorderBrush" Value="#80D8CF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="Margin" Value="0,8,0,10"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel><ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" Foreground="#C6E9EC" Background="#24364B" BorderBrush="#405873" Padding="12,9">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><DockPanel><TextBlock x:Name="Mark" Text="＋" Foreground="#80D8CF" Margin="0,0,10,0"/><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="#D5E8F4"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Text" Value="−"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
            </ToggleButton><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="8,12,8,6"/></StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4C627A" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F6FC"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style x:Key="SmartCardBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource SmartCard}"/><Setter Property="BorderBrush" Value="#34465E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
</ResourceDictionary>
