<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>SkyrimModPacker.UI</RootNamespace>
    <Product>Skyrim Mod Packer</Product>
    <Title>Skyrim Mod Packer</Title>
    <Description>Automated mod packaging utility for Skyrim SE/AE mods (Nexus Mods ready)</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="WPF-UI" Version="3.0.*" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="3.0.*" />
    <PackageReference Include="Serilog" Version="4.0.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyrimModPacker.Core\SkyrimModPacker.Core.csproj" />
    <ProjectReference Include="..\SkyrimModPacker.Application\SkyrimModPacker.Application.csproj" />
    <ProjectReference Include="..\SkyrimModPacker.Infrastructure\SkyrimModPacker.Infrastructure.csproj" />
  </ItemGroup>

</Project>
