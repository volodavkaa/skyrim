<Page
    x:Class="SkyrimModPacker.UI.Views.Pages.BuildPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SkyrimModPacker.UI.ViewModels"
    xmlns:controls="clr-namespace:SkyrimModPacker.UI.Controls"
    xmlns:models="clr-namespace:SkyrimModPacker.Core.Models;assembly=SkyrimModPacker.Core"
    d:DataContext="{d:DesignInstance vm:BuildViewModel, IsDesignTimeCreatable=False}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Build"
    Loaded="OnPageLoaded"
    AllowDrop="True"
    Drop="OnPageDrop"
    DragOver="OnPageDragOver"
    d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header & Action Bar -->
            <RowDefinition Height="Auto" />
            <!-- Notifications / Progress -->
            <RowDefinition Height="Auto" />
            <!-- File Tree Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <ui:Card Grid.Row="0" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Build_ModProfile}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center" />

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <ui:Button Content="Підготовка моделі"
                               Click="OnPrepareModel"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource Build_Scan}"
                               Icon="{ui:SymbolIcon Search24}"
                               Command="{Binding ScanCommand}"
                               Margin="0,0,8,0"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" />

                    <ui:Button Content="{DynamicResource Build_Pack}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Archive24}"
                               Command="{Binding PackCommand}"
                               Margin="0,0,8,0"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}" />

                    <ui:Button Content="{DynamicResource Build_Cancel}"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Command="{Binding CancelOperationCommand}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Notification & Progress Area -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <controls:PluginDiagnosticsView Diagnostics="{Binding PluginDiagnostics}" />
            <ui:Button Content="{DynamicResource Esl_Analyze}"
                       Command="{Binding AnalyzeEslCommand}"
                       Margin="0,0,0,8"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />
            <TextBlock Text="{Binding AnalyzedPluginPath}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EslAnalysisError}" TextWrapping="Wrap"
                       Visibility="{Binding EslAnalysisError, Converter={StaticResource NotNullToVisibilityConverter}}" />
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding EslAnalysis, Converter={StaticResource NotNullToVisibilityConverter}}">
                <TextBlock Text="{DynamicResource Esl_Compatible}"
                           Visibility="{Binding EslAnalysis.IsCompatible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{DynamicResource Esl_Incompatible}"
                           Visibility="{Binding EslAnalysis.IsCompatible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <WrapPanel>
                    <TextBlock Text="{DynamicResource Esl_OwnRecords}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding EslAnalysis.OwnRecordCount}" Margin="0,0,16,0" />
                    <TextBlock Text="{DynamicResource Esl_Problems}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding EslAnalysis.ProblematicRecordCount}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding EslAnalysis.Reasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- Progress Bar -->
            <ProgressBar Height="4"
                         Margin="0,0,0,8"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />

            <!-- Success Notification -->
            <ui:InfoBar Title="{DynamicResource Build_ArchiveReady}"
                        Message="{Binding StatusMessage}"
                        Severity="Success"
                        IsOpen="{Binding HasSuccessNotification}"
                        Margin="0,0,0,8">
                <ui:InfoBar.Content>
                    <ui:Button Content="{DynamicResource Build_ShowInExplorer}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Margin="0,8,0,0"
                               Command="{Binding OpenArchiveLocationCommand}" />
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <!-- Error Notification -->
            <ui:InfoBar Title="{DynamicResource Build_Error}"
                        Message="{Binding ErrorMessage}"
                        Severity="Error"
                        IsOpen="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=False}"
                        Margin="0,0,0,8" />
        </StackPanel>

        <!-- Main Workspace: File Tree or Empty Placeholder -->
        <Grid Grid.Row="2">
            <!-- Empty Placeholder -->
            <ui:Card VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     Visibility="{Binding HasScannedFiles, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderSearch24"
                                   FontSize="64"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource Build_NoFilesScannedTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Build_DragDropHint}"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ui:Card>

            <!-- File Tree Preview -->
            <ui:Card VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     Padding="16"
                     Visibility="{Binding HasScannedFiles, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Summary & Selection Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Tree View -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding SummaryText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Build_SelectAll}"
                                       Margin="0,0,8,0"
                                       Command="{Binding SelectAllCommand}" />
                            <ui:Button Content="{DynamicResource Build_DeselectAll}"
                                       Command="{Binding DeselectAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- TreeView -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FileTree}"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:FileTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Three-state Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              IsThreeState="True"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />

                                    <!-- Node Icon -->
                                    <ui:SymbolIcon Grid.Column="1"
                                                   Symbol="{Binding IsDirectory, Converter={StaticResource DirectoryToIconConverter}}"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                    <!-- Node Name -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               FontWeight="{Binding IsDirectory, Converter={StaticResource DirectoryToFontWeightConverter}}"
                                               VerticalAlignment="Center" />

                                    <!-- Category Badge for files -->
                                    <Border Grid.Column="3"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0"
                                            Visibility="{Binding IsDirectory, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- Formatted Size -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding FormattedSize}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
