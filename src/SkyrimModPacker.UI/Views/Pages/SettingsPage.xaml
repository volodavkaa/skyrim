<Page
    x:Class="SkyrimModPacker.UI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SkyrimModPacker.UI.ViewModels"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel, IsDesignTimeCreatable=False}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Title -->
            <TextBlock Text="{DynamicResource Settings_Title}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <!-- Feedback InfoBars -->
            <StackPanel Margin="0,0,0,16">
                <ui:InfoBar Title="Success"
                            Message="{Binding StatusMessage}"
                            Severity="Success"
                            IsOpen="{Binding StatusMessage, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=False}"
                            Margin="0,0,0,8" />

                <ui:InfoBar Title="Error"
                            Message="{Binding ErrorMessage}"
                            Severity="Error"
                            IsOpen="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}, FallbackValue=False}" />
            </StackPanel>

            <!-- Card 1: Skyrim Data Directory -->
            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="Folder24"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Settings_SkyrimDataTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Settings_SkyrimDataDesc}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SkyrimDataPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. C:\Games\Skyrim Special Edition\Data"
                                    Margin="0,0,8,0" />

                        <ui:Button Grid.Column="1"
                                   Content="{DynamicResource Settings_Browse}"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding BrowseSkyrimDataCommand}"
                                   Margin="0,0,8,0" />

                        <ui:Button Grid.Column="2"
                                   Content="{DynamicResource Settings_AutoDetect}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding AutoDetectSkyrimCommand}"
                                   IsEnabled="{Binding IsLocating, Converter={StaticResource InverseBooleanConverter}}" />
                    </Grid>

                    <!-- Validation Status Badge -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsValidSkyrimData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="LightGreen" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Settings_ValidFolder}"
                                   FontSize="13"
                                   Foreground="LightGreen"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Packaging & Output Options -->
            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Archive24"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Settings_PackagingTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Output Folder -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Settings_OutputDirTitle}"
                                   FontWeight="Medium"
                                   Margin="0,0,0,6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Output directory path"
                                        Margin="0,0,8,0" />

                            <ui:Button Grid.Column="1"
                                       Content="{DynamicResource Settings_Browse}"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Command="{Binding BrowseOutputDirectoryCommand}"
                                       Margin="0,0,8,0" />

                            <ui:Button Grid.Column="2"
                                       Content="{DynamicResource Settings_Desktop}"
                                       Command="{Binding ResetOutputDirectoryCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Staging Directory Toggle -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_StagingToggleTitle}" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{DynamicResource Settings_StagingToggleDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding UseTempDirectory, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>

                    <!-- Overwrite Existing Archive Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings_OverwriteToggleTitle}" FontWeight="Medium" Margin="0,0,0,2" />
                            <TextBlock Text="{DynamicResource Settings_OverwriteToggleDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding OverwriteExistingArchive, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Card 3: Appearance & Language -->
            <ui:Card Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="DarkTheme24"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                       Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Settings_AppearanceTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_Theme}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Theme, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource Settings_ThemeDark}" Tag="Dark" />
                            <ComboBoxItem Content="{DynamicResource Settings_ThemeLight}" Tag="Light" />
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Settings_Language}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Language, Mode=TwoWay}">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Українська" Tag="uk" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Save Button -->
            <ui:Button Content="{DynamicResource Settings_Save}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Command="{Binding SaveSettingsCommand}"
                       HorizontalAlignment="Left"
                       Padding="24,10" />
        </StackPanel>
    </ScrollViewer>
</Page>
