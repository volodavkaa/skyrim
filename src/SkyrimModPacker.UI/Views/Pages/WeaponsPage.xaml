<Page x:Class="SkyrimModPacker.UI.Views.Pages.WeaponsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{DynamicResource Nav_Weapons}" Loaded="OnPageLoaded" Unloaded="OnPageUnloaded" xmlns:layout="clr-namespace:SkyrimModPacker.UI.Controls" x:Name="WeaponsEditor" UseLayoutRounding="True" SnapsToDevicePixels="True" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="WizardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" MaxWidth="1160">
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding EditorScale, ElementName=WeaponsEditor}" ScaleY="{Binding EditorScale, ElementName=WeaponsEditor}" />
                </StackPanel.LayoutTransform>
                <Border CornerRadius="14" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="3,0,0,0" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Weapons_StudioLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource Nav_Weapons}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Weapons_Subtitle}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVisibilityConverter}}" />
                <layout:PluginDiagnosticsView Diagnostics="{Binding PluginDiagnostics}" />
                <Grid Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ui:Button Grid.Column="1" Content="{DynamicResource Build_Cancel}" Command="{Binding CancelOperationCommand}" />
                </Grid>
                <StackPanel IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                    <layout:ResponsiveColumnsPanel MinColumnWidth="110" MaxColumns="5" Gap="8" Margin="0,0,0,24">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModStep}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource Wizard_StepMod}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTemplateStep}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource Wizard_StepTemplate}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelStep}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource Wizard_StepModel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPropertiesStep}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource Wizard_StepProperties}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBadge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryStep}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{DynamicResource Wizard_StepSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </layout:ResponsiveColumnsPanel>
                    <StackPanel Visibility="{Binding IsModStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <layout:ResponsiveColumnsPanel MinColumnWidth="380" Gap="20" Margin="0,0,0,20">
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Weapons_BaseConnected}" FontWeight="SemiBold" Visibility="{Binding IsBaseConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{DynamicResource Weapons_BaseDisconnected}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBaseConnected}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Weapons_BaseHint}" TextWrapping="Wrap" Margin="0,6,0,6" />
                                    <TextBlock Text="{Binding GameDataPath}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <ui:Button Content="{DynamicResource Weapons_ChooseData}" Command="{Binding ChooseGameDataCommand}" Margin="0,0,8,4" />
                                        <ui:Button Content="{DynamicResource Weapons_LoadTemplates}" Command="{Binding LoadTemplatesCommand}" Margin="0,0,0,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Weapons_Project}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ProjectFilePath}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <ui:Button Content="{DynamicResource Weapons_OpenProject}" Command="{Binding OpenProjectCommand}" Margin="0,0,8,4" />
                                        <ui:Button Content="{DynamicResource Weapons_ImportProject}" Command="{Binding ImportProjectCommand}" Margin="0,0,0,4" />
                                    </WrapPanel>
                                    <TextBlock Text="{DynamicResource Weapons_ProjectHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{DynamicResource Weapons_ActivePlugin}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ui:TextBox Text="{Binding PluginPath, Mode=OneWay}" IsReadOnly="True" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Content="{DynamicResource Weapons_Open}" Command="{Binding OpenPluginCommand}" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Expander Header="{DynamicResource Weapons_CreatePlugin}" IsExpanded="{Binding ShowCreationPanel, Mode=TwoWay}">
                                        <StackPanel Margin="0,12,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{DynamicResource Weapons_PluginName}" Margin="0,0,0,6" />
                                                    <ui:TextBox Text="{Binding PluginName, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{Binding PluginNameError}" Style="{StaticResource FieldError}" Visibility="{Binding PluginNameError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Weapons_PluginType}" Margin="0,0,0,6" />
                                                    <ComboBox ItemsSource="{Binding PluginExtensions}" SelectedItem="{Binding PluginExtension, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Weapons_Workspace}" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding OutputDirectoryError}" Style="{StaticResource FieldError}" Visibility="{Binding OutputDirectoryError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <ui:Button Grid.Column="1" Content="{DynamicResource Weapons_Browse}" Command="{Binding BrowseOutputDirectoryCommand}" />
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Weapons_Masters}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                            <ui:TextBox Text="{Binding MastersText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                            <ui:Button Content="{DynamicResource Weapons_CreatePlugin}" Command="{Binding CreatePluginCommand}" Appearance="Primary" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ui:Card>
                        </layout:ResponsiveColumnsPanel>
                        <TextBlock Text="{Binding ProjectError}" Style="{StaticResource FieldError}" Visibility="{Binding ProjectError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsTemplateStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Wizard_StepTemplate}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <layout:ResponsiveColumnsPanel MinColumnWidth="350" Gap="20" Margin="0,0,0,20">
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Weapons_Template}" VerticalAlignment="Center" Margin="0,0,12,4" />
                                    </WrapPanel>
                                    <TextBlock Text="{DynamicResource Weapons_TemplateSearch}" Margin="0,0,0,6" />
                                    <ui:TextBox Text="{Binding TemplateSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding FilteredTemplates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" Margin="0,0,0,12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding EditorId}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding FormId, StringFormat={}{0:X6}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ui:Button Content="{DynamicResource Weapons_NewSword}" Command="{Binding NewSwordCommand}" Margin="0,0,0,16" />
                                    <TextBlock Text="{Binding TemplateError}" Style="{StaticResource FieldError}" Visibility="{Binding TemplateError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Weapons_InPlugin}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                                    <DataGrid ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" Height="265" Margin="0,0,0,12" RowHeight="40" ColumnHeaderHeight="36" AlternationCount="2" AlternatingRowBackground="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource Weapons_Name}" Binding="{Binding Name}" Width="2*" MinWidth="100" />
                                            <DataGridTextColumn Header="FormID" Binding="{Binding FormId, StringFormat={}{0:X6}}" Width="75" />
                                            <DataGridTextColumn Header="EditorID" Binding="{Binding EditorId}" Width="*" MinWidth="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <ui:Button Content="{DynamicResource Weapons_Delete}" Command="{Binding DeleteSwordCommand}" Appearance="Danger" HorizontalAlignment="Left" />
                                    <TextBlock Text="{DynamicResource Weapons_BackupHint}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </ui:Card>
                        </layout:ResponsiveColumnsPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsModelStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Wizard_StepModel}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <layout:ResponsiveColumnsPanel MinColumnWidth="350" Gap="20" Margin="0,0,0,20">
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Models_Third}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <Border BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,12" AllowDrop="True" PreviewDragOver="OnModelDragOver" PreviewDrop="OnModelDrop" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Weapons_ModelDropHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <ui:Button Content="{DynamicResource Weapons_ImportModel}" Command="{Binding ImportModelCommand}" Margin="0,0,0,8" Appearance="Primary" />
                                            <ui:TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Content="{DynamicResource Models_Restore}" Command="{Binding RestoreThirdPersonModelCommand}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding ThirdPersonModelStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding ModelPathError}" Style="{StaticResource FieldError}" Visibility="{Binding ModelPathError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Models_First}" Margin="0,0,0,8" />
                                    <ui:Button Content="{DynamicResource Weapons_ImportModel}" Command="{Binding ImportFirstPersonModelCommand}" Margin="0,0,0,8" />
                                    <ui:TextBox Text="{Binding FirstPersonModelPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Content="{DynamicResource Models_Restore}" Command="{Binding RestoreFirstPersonModelCommand}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding FirstPersonModelStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <ui:Button Content="{DynamicResource Weapons_CheckResources}" Command="{Binding CheckModelsCommand}" Margin="0,8,0,0" />
                                    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding RestorationTemplate}" DisplayMemberPath="EditorId" Margin="0,12,0,0" />
                                    <TextBlock Text="{DynamicResource Models_RestoreHint}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Weapons_Resources}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <TextBlock Text="{DynamicResource Weapons_TextureHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource Weapons_TextureSubdirectory}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <ui:TextBox Text="{Binding TextureSubdirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <ui:Button Content="{DynamicResource Weapons_ImportTextures}" Command="{Binding ImportTexturesCommand}" Margin="0,0,8,8" />
                                        <ui:Button Content="{DynamicResource Weapons_ImportTextureFolder}" Command="{Binding ImportTextureFolderCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <ui:Button Content="{DynamicResource Weapons_CheckResources}" Command="{Binding CheckResourcesCommand}" />
                                </StackPanel>
                            </ui:Card>
                        </layout:ResponsiveColumnsPanel>
                        <ui:Card Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Resources_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Resources_SavedHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ui:Button Content="{DynamicResource Resources_Refresh}" Command="{Binding RefreshResourceCatalogCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding ResourceCatalogError}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ResourceCatalogDiagnostics}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding ResourceCatalog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12" Margin="0,4,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <WrapPanel Margin="0,6,0,6">
                                                        <TextBlock Text="{Binding OriginText}" Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding AvailabilityText}" Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding RegistrationText}" Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding ArchiveText}" Margin="0,0,0,4" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                        <TextBlock Text="{Binding ResourceStatus}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsPropertiesStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Wizard_StepProperties}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <layout:ResponsiveColumnsPanel MinColumnWidth="350" Gap="20" Margin="0,0,0,20">
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="EditorID" Margin="0,0,0,6" />
                                    <ui:TextBox Text="{Binding EditorId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding EditorIdError}" Style="{StaticResource FieldError}" Visibility="{Binding EditorIdError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <TextBlock Text="{DynamicResource Weapons_Name}" Margin="0,0,0,6" />
                                    <ui:TextBox Text="{Binding WeaponName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding WeaponNameError}" Style="{StaticResource FieldError}" Visibility="{Binding WeaponNameError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                    <layout:ResponsiveColumnsPanel MinColumnWidth="155" MaxColumns="3" Gap="12" Margin="0,0,0,12">
                                        <StackPanel Margin="0">
                                            <TextBlock Text="{DynamicResource Weapons_Damage}" Margin="0,0,0,6" />
                                            <ui:TextBox Text="{Binding Damage, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding DamageError}" Style="{StaticResource FieldError}" Visibility="{Binding DamageError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0">
                                            <TextBlock Text="{DynamicResource Weapons_Weight}" Margin="0,0,0,6" />
                                            <ui:TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding WeightError}" Style="{StaticResource FieldError}" Visibility="{Binding WeightError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0">
                                            <TextBlock Text="{DynamicResource Weapons_Value}" Margin="0,0,0,6" />
                                            <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding ValueError}" Style="{StaticResource FieldError}" Visibility="{Binding ValueError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        </StackPanel>
                                    </layout:ResponsiveColumnsPanel>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0">
                                <Expander Header="{DynamicResource Weapons_Advanced}" IsExpanded="{Binding ShowAdvancedProperties, Mode=TwoWay}" Margin="0,0,0,12">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Weapons_Description}" Margin="0,0,0,6" />
                                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" Margin="0,0,0,12" />
                                        <layout:ResponsiveColumnsPanel MinColumnWidth="155" MaxColumns="3" Gap="12" Margin="0,0,0,12">
                                            <StackPanel Margin="0">
                                                <TextBlock Text="{DynamicResource Weapons_Speed}" Margin="0,0,0,6" />
                                                <ui:TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding SpeedError}" Style="{StaticResource FieldError}" Visibility="{Binding SpeedError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0">
                                                <TextBlock Text="{DynamicResource Weapons_Reach}" Margin="0,0,0,6" />
                                                <ui:TextBox Text="{Binding Reach, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="{Binding ReachError}" Style="{StaticResource FieldError}" Visibility="{Binding ReachError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                            </StackPanel>
                                        </layout:ResponsiveColumnsPanel>
                                        <TextBlock Text="{DynamicResource Weapons_Keywords}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Options.Keywords}" DisplayMemberPath="DisplayName" SelectedItem="{Binding KeywordToAdd, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,6" />
                                        <WrapPanel Margin="0,0,0,6">
                                            <ui:Button Content="{DynamicResource Weapons_Add}" Command="{Binding AddKeywordCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="{DynamicResource Weapons_Remove}" Command="{Binding RemoveKeywordCommand}" />
                                        </WrapPanel>
                                        <ListBox ItemsSource="{Binding WeaponKeywords}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedKeyword, Mode=TwoWay}" Height="90" Margin="0,0,0,12" />
                                        <TextBlock Text="{DynamicResource Weapons_Sound}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding SoundChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSound, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,6" />
                                        <ui:Button Content="{DynamicResource Weapons_Clear}" Command="{Binding ClearSoundCommand}" Margin="0,0,0,12" />
                                        <TextBlock Text="{DynamicResource Weapons_Enchantment}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding EnchantmentChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedEnchantment, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,6" />
                                        <ui:Button Content="{DynamicResource Weapons_Clear}" Command="{Binding ClearEnchantmentCommand}" Margin="0,0,0,12" />
                                        <TextBlock Text="{DynamicResource Weapons_Charge}" Margin="0,0,0,6" />
                                        <ui:TextBox Text="{Binding EnchantmentCharge, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding ChargeError}" Style="{StaticResource FieldError}" Visibility="{Binding ChargeError, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        <ui:Button Content="{DynamicResource Weapons_LoadOptions}" Command="{Binding LoadOptionsCommand}" />
                                    </StackPanel>
                                </Expander>
                            </ui:Card>
                        </layout:ResponsiveColumnsPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Wizard_StepSummary}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <layout:ResponsiveColumnsPanel MinColumnWidth="350" Gap="20" Margin="0,0,0,20">
                            <ui:Card Padding="24" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Wizard_SummaryHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding WeaponSummary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Wizard_ProjectFiles}" FontWeight="SemiBold" Margin="0,8,0,8" />
                                    <ItemsControl ItemsSource="{Binding SummaryFiles}" Margin="0,0,0,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Content="{DynamicResource Wizard_SaveSword}" Command="{Binding SaveWizardSwordCommand}" Appearance="Primary" />
                                    <TextBlock Text="{DynamicResource Wizard_Saved}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding IsWizardSaved, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{DynamicResource Weapons_ProjectPackingHint}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    <CheckBox IsChecked="{Binding EnableProjectEsl, Mode=TwoWay}" Margin="0,12,0,12">
                                        <TextBlock Text="{DynamicResource Profiles_EnableEsl}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <ui:Button Content="{DynamicResource Weapons_PackProject}" Command="{Binding PackProjectCommand}" Appearance="Primary" />
                                    <TextBlock Text="{DynamicResource Weapons_LastProjectArchive}" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding LastProjectArchivePath}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>
                        </layout:ResponsiveColumnsPanel>
                        <Expander Header="{DynamicResource Wizard_Acquisition}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Wizard_AcquisitionHint}" TextWrapping="Wrap" Margin="0,8,0,12" />
                                <StackPanel IsEnabled="{Binding HasSelectedWeapon}">
                                    <ui:Card Padding="16" Margin="0,0,0,16">
                                        <Expander Header="{DynamicResource Weapons_Crafting}">
                                            <StackPanel Margin="0,12,0,0">
                                                <WrapPanel Margin="0,0,0,8">
                                                    <ui:Button Content="{DynamicResource Weapons_LoadRecipes}" Command="{Binding LoadRecipesCommand}" Margin="0,0,8,0" />
                                                    <ui:Button Content="{DynamicResource Weapons_NewRecipe}" Command="{Binding NewRecipeCommand}" />
                                                </WrapPanel>
                                                <ComboBox ItemsSource="{Binding Recipes}" DisplayMemberPath="EditorId" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}" Margin="0,0,0,12" />
                                                <TextBlock Text="{DynamicResource Weapons_RecipeId}" Margin="0,0,0,6" />
                                                <ui:TextBox Text="{Binding RecipeEditorId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                                <TextBlock Text="{DynamicResource Weapons_Workbench}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding WorkbenchChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedWorkbench, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,12" />
                                                <TextBlock Text="{DynamicResource Weapons_OutputCount}" Margin="0,0,0,6" />
                                                <ui:TextBox Text="{Binding RecipeOutputCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                                <TextBlock Text="{DynamicResource Weapons_Ingredients}" Margin="0,0,0,6" />
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="85" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Options.Ingredients}" DisplayMemberPath="DisplayName" SelectedItem="{Binding IngredientToAdd, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,8,0" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding IngredientCount, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <ui:Button Content="{DynamicResource Weapons_Add}" Command="{Binding AddIngredientCommand}" Margin="0,0,8,0" />
                                                    <ui:Button Content="{DynamicResource Weapons_Remove}" Command="{Binding RemoveIngredientCommand}" />
                                                </WrapPanel>
                                                <ListBox ItemsSource="{Binding RecipeIngredients}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}" Height="90" Margin="0,0,0,12" />
                                                <TextBlock Text="{DynamicResource Weapons_Perk}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding PerkChoices}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedPerk, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,6" />
                                                <ui:Button Content="{DynamicResource Weapons_Clear}" Command="{Binding ClearPerkCommand}" Margin="0,0,0,12" />
                                                <WrapPanel>
                                                    <ui:Button Content="{DynamicResource Weapons_SaveRecipe}" Command="{Binding SaveRecipeCommand}" Appearance="Primary" Margin="0,0,8,8" />
                                                    <ui:Button Content="{DynamicResource Weapons_DeleteRecipe}" Command="{Binding DeleteRecipeCommand}" Appearance="Danger" Margin="0,0,0,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </ui:Card>
                                    <ui:Card Padding="16" Margin="0,0,0,16">
                                        <Expander Header="{DynamicResource Weapons_LeveledLists}">
                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Text="{DynamicResource Weapons_ListHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <ComboBox ItemsSource="{Binding Options.LeveledLists}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLeveledList, Mode=TwoWay}" IsTextSearchEnabled="True" Margin="0,0,0,12" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{DynamicResource Weapons_Level}" Margin="0,0,0,6" />
                                                        <ui:TextBox Text="{Binding ListLevel, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{DynamicResource Weapons_Count}" Margin="0,0,0,6" />
                                                        <ui:TextBox Text="{Binding ListCount, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <ui:Button Content="{DynamicResource Weapons_AddToList}" Command="{Binding AddToListCommand}" Margin="0,0,8,8" />
                                                    <ui:Button Content="{DynamicResource Weapons_RemoveFromList}" Command="{Binding RemoveFromListCommand}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </ui:Card>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Weapons_Packing}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ComboBox ItemsSource="{Binding PackingProfiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPackingProfile, Mode=TwoWay}" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <ui:Button Content="{DynamicResource Weapons_CreateProfile}" Command="{Binding CreatePackingProfileCommand}" Margin="0,0,8,8" />
                                    <ui:Button Content="{DynamicResource Weapons_LinkProfile}" Command="{Binding LinkPackingProfileCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Weapons_Zoom}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Minimum="0.85" Maximum="1.3" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="90" VerticalAlignment="Center" Value="{Binding EditorScale, ElementName=WeaponsEditor, Mode=TwoWay}" />
                    <TextBlock Text="{Binding EditorScale, ElementName=WeaponsEditor, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" Grid.Column="1">
                    <ui:Button Content="{DynamicResource Wizard_Back}" Command="{Binding PreviousStepCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="{DynamicResource Wizard_Next}" Command="{Binding NextStepCommand}" Appearance="Primary" Visibility="{Binding CanGoNext, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
