           <ComboBox ItemsSource="{Binding ListTargets}" SelectedItem="{Binding SelectedListTarget}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedListTarget.DisplayName}"/>
           </StackPanel>
           <TextBlock Text="{DynamicResource Smart_ListSharedWarning}" TextWrapping="Wrap" Foreground="#FFDC9E" Margin="0,10"/>
           <TextBlock Text="{Binding ListTargetResultText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8"/>
           <Expander IsExpanded="{Binding IsAdvancedListSelection, Mode=OneWay}"><Expander.Header><TextBlock Text="{DynamicResource Smart_ListAdvancedSearch}" TextWrapping="Wrap"/></Expander.Header><StackPanel>
           <TextBlock Text="{DynamicResource Smart_ListSearch}"/><TextBox Text="{Binding ListSearch, UpdateSourceTrigger=PropertyChanged}"/>
           <WrapPanel><Button Content="{DynamicResource Smart_ListAll}" Command="{Binding FilterListCommand}" CommandParameter=""/><Button Content="{DynamicResource Smart_ListCategory_Containers}" Command="{Binding FilterListCommand}" CommandParameter="Containers"/><Button Content="{DynamicResource Smart_ListCategory_Merchants}" Command="{Binding FilterListCommand}" CommandParameter="Merchants"/><Button Content="{DynamicResource Smart_ListCategory_Equipment}" Command="{Binding FilterListCommand}" CommandParameter="Equipment"/><Button Content="{DynamicResource Smart_ListUnknown}" Command="{Binding FilterListCommand}" CommandParameter="Unknown"/></WrapPanel>
           <TextBlock Text="{DynamicResource Smart_ListLimit}" TextWrapping="Wrap"/>
           </StackPanel></Expander>
           <StackPanel Visibility="{Binding CanShowTargetLists, Converter={StaticResource Visible}}">
           <ListBox ItemsSource="{Binding FilteredLeveledLists}" SelectedItem="{Binding SelectedLeveledList}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Name}"/><Style.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Text" Value="{DynamicResource Smart_ListUnnamed}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="{Binding EditorId}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Reference.PluginName}" Foreground="#B4C3D5"/>
            <TextBlock TextWrapping="Wrap" Foreground="#B4C3D5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource Smart_ListUnknown}"/><Style.Triggers>
             <DataTrigger Binding="{Binding ListUsages[0].Category}" Value="Containers"><Setter Property="Text" Value="{DynamicResource Smart_ListCategory_Containers}"/></DataTrigger>
             <DataTrigger Binding="{Binding ListUsages[0].Category}" Value="Merchants"><Setter Property="Text" Value="{DynamicResource Smart_ListCategory_Merchants}"/></DataTrigger>
             <DataTrigger Binding="{Binding ListUsages[0].Category}" Value="Equipment"><Setter Property="Text" Value="{DynamicResource Smart_ListCategory_Equipment}"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style></TextBlock>
           </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
           <Expander><Expander.Header><TextBlock Text="{DynamicResource Smart_ListInspectHint}" TextWrapping="Wrap"/></Expander.Header><StackPanel>
           <TextBlock Text="{DynamicResource Smart_ListExplanation}" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding LeveledListPurpose}" TextWrapping="Wrap" Margin="0,10"/>
           <TextBlock Text="{DynamicResource Smart_ListContents}" FontWeight="SemiBold"/><TextBox Text="{Binding ListContents, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
           </StackPanel></Expander>
           <TextBlock Text="{DynamicResource Smart_ListMinLevel}"/><TextBox Text="{Binding ListLevel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{DynamicResource Smart_ListItemCount}"/><TextBox Text="{Binding ListCount, UpdateSourceTrigger=PropertyChanged}"/>
           <TextBlock Text="{Binding LeveledListSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10"/>
           <TextBlock Text="{DynamicResource Smart_ListOutcome}" TextWrapping="Wrap" Foreground="#B4C3D5"/>
           <Button Command="{Binding AddToListCommand}" Style="{StaticResource SmartPrimary}"><TextBlock Text="{DynamicResource Smart_ListSaveAndAdd}" TextWrapping="Wrap"/></Button>
           </StackPanel>
           </StackPanel>
          </StackPanel></Expander>
         </StackPanel>
         <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource Visible}}"><TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" FontSize="16"/><Button Content="{DynamicResource Smart_SaveItem}" Style="{StaticResource SmartPrimary}" Command="{Binding SaveItemCommand}" Margin="0,16,0,8"/><Expander Header="{DynamicResource Smart_Inheritance}"><TextBlock Text="{Binding InheritanceText}" TextWrapping="Wrap"/></Expander><TextBlock Text="{Binding SelectedItem.PreviewNotice}" TextWrapping="Wrap" Foreground="#B4C3D5" Margin="0,12,0,0"/></StackPanel>
        </StackPanel>
        <Border x:Name="PreviewHost" CornerRadius="10" Height="510" ClipToBounds="True" VerticalAlignment="Top"/>
       </layout:ResponsiveColumnsPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding IsResources, Converter={StaticResource Visible}}">
       <TextBlock Text="{DynamicResource Smart_Resources}" Style="{StaticResource Heading}"/><TextBlock Text="{DynamicResource Smart_TextureUsage}" TextWrapping="Wrap"/>
       <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="RelativePath" MaxHeight="240" Margin="0,12"/>
       <TextBlock Text="{Binding SelectedResource.OriginText}"/><TextBlock Text="{Binding SelectedResource.TypeText}"/><TextBlock Text="{Binding SelectedResource.AvailabilityText}"/><TextBlock Text="{Binding SelectedResource.ArchiveText}"/><TextBlock Text="{Binding SelectedResource.UsageText}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedResource.IssueText}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedResource.Detail}" TextWrapping="Wrap"/>
       <WrapPanel><Button Content="{DynamicResource Smart_ReplaceResource}" Click="OnReplaceResource"/><Button Content="{DynamicResource Smart_DeleteResource}" Click="OnDeleteResource"/><Button Content="{DynamicResource Smart_EditResourceOwner}" Click="OnEditResourceOwner"/></WrapPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding IsChecks, Converter={StaticResource Visible}}">
       <TextBlock Text="{DynamicResource Smart_Checks}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
       <WrapPanel><Button Content="{DynamicResource Smart_Validate}" Command="{Binding CheckCommand}"/><Button Content="{DynamicResource Smart_ReviewExternal}" Click="OnReviewExternal"/></WrapPanel>
       <ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.NavigateIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
