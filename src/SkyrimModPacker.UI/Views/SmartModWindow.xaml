        <TextBlock Text="{DynamicResource Smart_VariantLimit}"/>
        <ComboBox ItemsSource="{Binding VariantTextureSizes}" SelectedItem="{Binding VariantMaxTextureSize}" Width="150" HorizontalAlignment="Left"/>
        <TextBlock Text="{DynamicResource Smart_VariantTexconv}" Margin="0,6,0,0"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="…" Click="OnBrowseVariantTexconv"/><TextBox Text="{Binding VariantTexconvPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
        <TextBlock Text="{DynamicResource Smart_VariantHint}" TextWrapping="Wrap" Foreground="#B4C3D5"/>
       </StackPanel>
       <Button Content="{DynamicResource Smart_Pack}" Style="{StaticResource SmartPrimary}" Command="{Binding PackCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsFinished, Converter={StaticResource Visible}}">
       <TextBlock Text="{DynamicResource Smart_Finished}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding LastArchivePath}" TextWrapping="Wrap" Margin="0,12"/>
       <TextBlock Text="{DynamicResource Smart_VariantResult}" FontWeight="SemiBold" Visibility="{Binding CreateTextureVariant, Converter={StaticResource Visible}}"/>
       <TextBlock Text="{Binding LastVariantArchivePath}" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="{Binding CreateTextureVariant, Converter={StaticResource Visible}}"/>
       <Button Content="{DynamicResource Smart_VariantRetry}" Command="{Binding CreateVariantCommand}" HorizontalAlignment="Left" Visibility="{Binding CreateTextureVariant, Converter={StaticResource Visible}}"/>
       <WrapPanel><Button Content="{DynamicResource Smart_OpenFolder}" Command="{Binding OpenArchiveFolderCommand}"/><Button Content="{DynamicResource Smart_ReadReport}" Command="{Binding ReadReportCommand}"/><Button Content="{DynamicResource Smart_Continue}" Command="{Binding NavigateCommand}" CommandParameter="Overview"/></WrapPanel>
      </StackPanel>
      <Expander Header="{DynamicResource Smart_Messages}" Margin="0,16,0,8"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></Expander>
     </StackPanel>
    </ScrollViewer>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource SmartSurface}" CornerRadius="10" Padding="12,8" Margin="0,16,0,0"><DockPanel>
   <WrapPanel DockPanel.Dock="Right"><Button Content="{DynamicResource Smart_Start}" Style="{StaticResource SmartPrimary}" Command="{Binding CreateProjectCommand}" IsEnabled="{Binding CanCreateProject}" Visibility="{Binding ShowTemplateSetup, Converter={StaticResource Visible}}"/><Button Content="{DynamicResource Smart_SaveExit}" Click="OnSaveExit" Visibility="{Binding HasProject, Converter={StaticResource Visible}}"/><Button Content="{Binding NextActionText}" Style="{StaticResource SmartPrimary}" Command="{Binding NextCommand}" Visibility="{Binding HasProject, Converter={StaticResource Visible}}"/></WrapPanel>
   <StackPanel><TextBlock Text="{Binding SetupCountText}" Foreground="#B4C3D5" VerticalAlignment="Center" Margin="8,10" Visibility="{Binding ShowTemplateSetup, Converter={StaticResource Visible}}"/><Button Content="{DynamicResource Smart_Back}" Command="{Binding PreviousCommand}" HorizontalAlignment="Left" Visibility="{Binding HasProject, Converter={StaticResource Visible}}"/><TextBlock Text="{Binding SaveStatus}" Foreground="#B4C3D5" FontSize="12" TextWrapping="Wrap"/></StackPanel>
  </DockPanel></Border>
 </Grid>
</Window>
