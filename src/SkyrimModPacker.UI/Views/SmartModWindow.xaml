           <Button Command="{Binding FilterListCommand}" CommandParameter="Containers" HorizontalContentAlignment="Left"><TextBlock Text="{DynamicResource Smart_ListWantChest}" TextWrapping="Wrap"/></Button>
           <Button Command="{Binding FilterListCommand}" CommandParameter="Merchants" HorizontalContentAlignment="Left"><TextBlock Text="{DynamicResource Smart_ListWantMerchant}" TextWrapping="Wrap"/></Button>
           <Button Content="{DynamicResource Smart_ListWantAdvanced}" Command="{Binding FilterListCommand}" CommandParameter="All"/>
           <Button Command="{Binding SkipListCommand}"><TextBlock Text="{DynamicResource Smart_ListSkip}" TextWrapping="Wrap"/></Button>
           <StackPanel Visibility="{Binding ShowListChoices, Converter={StaticResource Visible}}">
           <TextBlock Text="{Binding ListScenarioHelp}" TextWrapping="Wrap" Margin="0,10"/>
